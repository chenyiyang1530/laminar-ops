# 复制为 .env 或设置到系统环境变量；不要把真实值提交仓库

# 数据库
DB_URL=jdbc:mysql://127.0.0.1:3306/laminar_ops?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=laminar_ops
DB_PASSWORD=请替换为强密码
MYSQL_ROOT_PASSWORD=仅运维脚本使用，单独保存

# Redis（无密码时留空）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=请替换为Redis密码

# JWT，至少 32 字节随机值
JWT_SECRET=请替换为随机字符串

# 敏感参数加密密钥，至少 32 字节；设置后不要随意更换
CONFIG_SECRET=请替换为另一段随机字符串

# 文件下载签名密钥；可留空复用 CONFIG_SECRET
FILE_SIGN_SECRET=请替换为随机字符串
FILE_SIGN_TTL_SECONDS=1800

# HTTPS（可选，生产建议由 Nginx 终止 TLS）
HTTPS_PORT=8443
TLS_KEYSTORE=file:./certs/laminar-local.p12
TLS_KEYSTORE_PASSWORD=请替换为证书密码
TLS_KEY_ALIAS=laminar

# 上传病毒扫描与清理
UPLOAD_VIRUS_SCAN=false
CLAMAV_COMMAND=clamdscan
UPLOAD_CLEANUP_ENABLED=false
UPLOAD_CLEANUP_DAYS=180

# 定时备份（应用内调用 tools/backup.ps1）
BACKUP_ENABLED=true
BACKUP_SCRIPT=D:/ideaWork/laminar-ops/tools/backup.ps1
BACKUP_DIR=D:/backups/laminar-ops
BACKUP_CRON=0 0 2 * * *

# 异地备份：二选一，或都不填仅保留本地
BACKUP_OFFSITE_PATH=
# BACKUP_RCLONE_REMOTE=remote:laminar-ops/backups

# 备份加密密码，必须设置
BACKUP_ENCRYPTION_PASSWORD=请替换为备份加密密码

# 设备网关 Token，不要使用默认值
MONITOR_TOKEN=请替换为网关Token

# 生产环境必须为 false
VERIFICATION_DEV_MODE=false

# 允许的前端来源，生产改成实际域名
CORS_ALLOWED_ORIGINS=https://ops.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://ops.example.com
