{
  "name": "laminar-ops-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "dev:portal": "vite --config vite.portal.config.js",
    "dev:portal:force": "vite --config vite.portal.config.js --force",
    "build": "node ../tools/gen-view-registry.js && rollup -c",
    "build:portal": "rollup -c rollup.portal.config.mjs",
    "watch": "node ../tools/gen-view-registry.js && rollup -c -w",
    "test:unit": "vitest run",
    "test:integration": "node ../tools/api-smoke-test.mjs",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^25.0.1",
    "rollup": "^4.66.0",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-vue": "^6.0.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
